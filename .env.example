# Template for App Store archive env vars. Copy to `.env` and fill in.
#   cp .env.example .env
#   set -a; source .env; set +a
#   ./scripts/archive-appstore.sh

# Apple Developer team
TEAM_ID=""
BUNDLE_ID="com.ferin79.multitimebar"

# Signing identities — must match `security find-identity -v` output exactly.
DIST_APP_IDENTITY="3rd Party Mac Developer Application: YOUR NAME (TEAMID)"
DIST_INSTALLER_IDENTITY="3rd Party Mac Developer Installer: YOUR NAME (TEAMID)"

# Provisioning profile embedded into the .app.
PROVISIONING_PROFILE="$HOME/Library/MobileDevice/Provisioning Profiles/YourProfile.provisionprofile"

# App Store Connect API key (optional; only needed for archive-appstore.sh --upload).
ASC_API_KEY_ID=""
ASC_API_ISSUER_ID=""
